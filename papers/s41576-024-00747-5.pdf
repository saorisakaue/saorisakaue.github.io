         <xmpMM:History>
            <rdf:Seq>
               <rdf:li rdf:parseType="Resource">
                  <stEvt:action>converted</stEvt:action>
                  <stEvt:instanceID>uuid:f53fbc95-a2fe-4eb0-aab2-bc67cdc20163</stEvt:instanceID>
